<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.dropproject.studentmodeijplugin</id>
    <name>Student Mode</name>
    <vendor>Drop Project</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- Soft dependency on the bundled Full Line Code Completion plugin, so Student Mode can turn off its
         local inline completion suggestions. Optional: Student Mode still works fully if it's absent/disabled. -->
    <depends optional="true" config-file="student-mode-fullline.xml">org.jetbrains.completion.full.line</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Register the StudentModeService -->
        <service serviceImplementation="org.dropproject.studentmodeijplugin.services.StudentModeService"/>

        <notificationGroup id="Student Mode Notifications" displayType="BALLOON"/>

        <!-- Status bar badge that only appears while Student Mode is on, so a proctor can verify it at a glance -->
        <statusBarWidgetFactory id="StudentModeStatusBarWidget"
                                 implementation="org.dropproject.studentmodeijplugin.statusbar.StudentModeWidgetFactory"
                                 order="first"/>
    </extensions>

    <applicationListeners>
        <!-- Keeps the .noai file in sync with Student Mode across every project window:
             creates/cleans it up on open, deletes it when that window closes. -->
        <listener class="org.dropproject.studentmodeijplugin.listeners.StudentModeProjectListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </applicationListeners>

    <actions>
        <!-- Student Mode Toggle Action in Toolbar -->
        <action id="ToggleStudentMode" 
                class="org.dropproject.studentmodeijplugin.actions.ToggleStudentModeAction"
                text="Toggle Student Mode"
                description="Enable/Disable Student Mode for this project"
                icon="/icons/studentModeOff.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>